{
  "name": "basketball-scoresheet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA for keeping a basketball scoresheet on a phone, following FIBA scoresheet conventions, and exporting it as a PDF.",
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o styles.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o styles.css --watch",
    "serve": "python -m http.server 5173",
    "dev": "npm run watch:css",
    "test": "node --test \"test/**/*.test.js\"",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run build:css && npm run build:site",
    "serve:site": "npm run build && python -m http.server 5174 -d _site",
    "lint": "eslint .",
    "video": "node scripts/record-video.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.3"
  }
}
