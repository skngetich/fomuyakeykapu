{
  "name": "fiba-scoresheet",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first PWA for keeping a FIBA basketball scoresheet and exporting it as a PDF.",
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o styles.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o styles.css --watch",
    "serve": "python -m http.server 5173",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
